  "voicePause": "Pause",
  "importIntro": "If you have written a journal somewhere else, Lamplight can read it in — as long as it is text files with the date in the name.",
  "importHowDates": "It reads plain text files and looks for a date in the name — 2026-08-24, or 24 August 2026 — anywhere in the file name or the folders above it.",
  "importAmbiguousDates": "Dates like 03-04-2026 are skipped on purpose. That is the third of April in some countries and the fourth of March in others, and guessing wrong would file a year of your life on the wrong days without telling you.",
  "@importAmbiguousDates": {
    "description": "Why a whole class of filename is skipped rather than guessed. The refusal is the feature — guessing wrong would file a year of somebody's life on the wrong days and say nothing about it."
  },
  "importFormats": "Lamplight reads plain text: .txt, .md, .org, .log and others, including files with no extension at all. If your journal is in another format, export it as text first.",
  "importAtStartOfDay": "They will sit at the start of each day, because a file name gives the date but not the time. Nothing already in Lamplight is changed or removed, and running this twice will not make copies.",
  "@importAtStartOfDay": {
    "description": "Two reassurances that matter before somebody commits: nothing already in Lamplight is touched, and running the import twice does not duplicate anything."
  },
  "importFileDateNote": "Puts them on the day the file was last changed. If the folder has been copied between devices, that may be the day it was copied rather than the day you wrote it.",
  "importSkippedNote": "These will be skipped. They stay exactly where they are — nothing is moved or deleted from your folder.",
  "restoreChooseNote": "Choose your backup file. It will be called something like Lamplight-2026-08-18.vault.",
  "restorePasscodeNote": "Enter the passcode for this file — the one that was set when the backup was made.",
  "restoreWordsNote": "Type the twelve words, in order, separated by spaces.",
  "restoreDoNotClose": "Do not close Lamplight until this finishes.",
  "exportIntro": "This writes everything in Lamplight into a folder you choose, as ordinary files — one text file for each day, and every photo, video, voice note and document under its own name.",
  "exportNoLamplightNeeded": "Nothing in that folder needs Lamplight to open it. If this app ever stops working, or you stop using it, your notes still open in anything that reads text.",
  "exportWhichOneBody": "A readable copy is for reading, moving to another app, or keeping something after you stop using Lamplight. It is not protected.\n\nA backup file is for getting Lamplight back exactly as it was — a new phone, or a phone that broke. It is locked with your passcode, so it is safe to keep anywhere, including a cloud drive.\n\nMost people want the backup. Take a readable copy as well if you want to be certain you are never stuck.",
  "@exportWhichOneBody": {
    "description": "The whole explanation of backup versus readable copy, in three paragraphs separated by blank lines. Keep the paragraph breaks — it is read by somebody deciding, not skimming."
  },
  "exportNotLockedBody": "It has no passcode on it. Anyone who opens that folder can read everything in it. Put it somewhere you are happy with that — and if you only want something safe to keep, use Back up instead.",
  "@exportNotLockedBody": {
    "description": "The warning that makes the readable copy honest. It is plain files with no passcode on them; anybody who opens that folder can read everything. It must not be softened, and it points at the safe alternative rather than just alarming."
  },
  "backupConfirmNote": "Confirm your passcode. This file can unlock everything, so making one should be something you meant to do.",
  "backupKeepSafeNote": "Your backup is locked with the passcode you have now. Keep it somewhere you trust — a cloud drive is fine, because the file is unreadable without that passcode. We never see it.",
  "@backupKeepSafeNote": {
    "description": "Why a backup is safe to put in a cloud drive: the file is unreadable without the passcode, and we never have it. Both halves are load-bearing."
  },
  "backupRestoreWarning": "Opening a backup replaces everything currently in Lamplight. Your current notes are kept aside until the restored ones are proven to open.",
  "@backupRestoreWarning": {
    "description": "Before restoring. The second sentence is the safety net and must survive: the current notes are kept aside until the restored ones are proven to open."
