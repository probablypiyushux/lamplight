  "onboardNoAccount": "There is no account.",
  "@onboardNoAccount": {
    "description": "The first thing a stranger ever reads in this app. A statement of fact about the software, not a boast. The ABSENCE of a signup screen is the pitch, so this must not be softened into a welcome."
  },
  "onboardPromiseBody": "Your notes stay on this phone.\nWe have no server. We cannot read them.\nWe cannot recover them either.",
  "@onboardPromiseBody": {
    "description": "Three factual claims, unsoftened. The third — that recovery is impossible — must NOT be softened or dropped in translation. It is the cost of the other two, and hiding it would be the exact dark pattern ETHICAL-DESIGN.md forbids."
  },
  "onboardBegin": "Begin",
  "onboardHaveBackup": "I have a backup",
  "onboardSetPasscode": "Set a passcode",
  "onboardPasscodeBody": "This is the only thing that opens your notes. A phrase you can remember is stronger than four digits.",
  "@onboardPasscodeBody": {
    "description": "Advice, not a rule. 'Stronger than' is a comparison, not a requirement — do not translate it into an instruction or a minimum."
  },
  "onboardPasscodeLabel": "Passcode",
  "onboardPasscodeAgain": "Type it again",
  "onboardSettingUp": "Setting up…",
  "onboardContinue": "Continue",
  "onboardPasscodesDiffer": "Those two do not match.",
  "@onboardPasscodesDiffer": {
    "description": "Shown when the two fields differ. States what is true of the two entries; it does not tell the person they are wrong. Same principle as lockWrongPasscode."
  },
  "onboardVaultFailed": "Your vault could not be created.",
  "onboardVaultFailedThen": "Nothing was saved. Try once more.",
  "onboardWriteWords": "Write these twelve words\non paper",
  "onboardWordsBody": "We do not have a copy. We cannot send them to you. There is no support email that can help you.\n\nNot a screenshot — paper. A screenshot sits in your gallery, which is the first place anyone looks.",
  "@onboardWordsBody": {
    "description": "The most important paragraph in onboarding. 'There is no support email that can help you' is literal and stays literal. 'Not a screenshot — paper' is the instruction that actually matters, and the reason given for it is the one that persuades."
  },
  "onboardWrittenDown": "I've written them down",
  "onboardCopyWords": "Copy the twelve words",
  "onboardClipboardNote": "The clipboard clears itself after a minute. Other apps can read it until it does.",
  "@onboardClipboardNote": {
    "description": "The honest cost of the convenience directly above it. ETHICAL-DESIGN.md cuts both ways: offering the copy as though it were free would be a dark pattern, and frightening somebody out of their own password manager would be another."
  },
  "onboardCopied": "Copied. It clears itself in a minute — paste it somewhere safe now.",
  "onboardCopyFailed": "That could not be copied. Writing them down is safer anyway.",
