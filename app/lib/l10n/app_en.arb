  "keptNoNetworkTitle": "It never goes anywhere",
  "@keptNoNetworkTitle": {
    "description": "Heading of the first claim in 'How your notes are kept'. A statement of fact about the software, not a reassurance."
  },
  "keptNoNetworkBody": "Lamplight cannot use the internet. Not \"does not\" — cannot: Android refuses it the permission, and you can check that yourself in the phone’s app settings in about thirty seconds.",
  "@keptNoNetworkBody": {
    "description": "The strongest claim the app makes. The 'cannot, not does not' distinction is the whole point and must survive translation — it is the difference between a promise and a verifiable fact. Keep the invitation to check."
  },
  "keptPasscodeTitle": "Your passcode is the key",
  "@keptPasscodeTitle": {
    "description": "Heading of the second claim in 'How your notes are kept'."
  },
  "keptPasscodeBody": "The key that opens your notes is made from your passcode every time you unlock. It is not stored anywhere, so there is no copy of it to find, to lose, or to hand over.",
  "@keptPasscodeBody": {
    "description": "Why there is no stored key. 'to find, to lose, or to hand over' names three different adversaries in six words — keep all three."
  },
  "keptForgetTitle": "If you forget it",
  "@keptForgetTitle": {
    "description": "Heading of the third claim in 'How your notes are kept'."
  },
  "keptForgetBody": "Your twelve words are the only other way in. Nobody can reset a passcode here, and that is the same fact as the one above — an app that could let you back in could let somebody else in too.",
  "@keptForgetBody": {
    "description": "Says the cost of the design honestly rather than hiding it. The 'same fact as the one above' link is the argument, not decoration."
  },
  "keptNothingReadableTitle": "Nothing readable is left lying about",
  "@keptNothingReadableTitle": {
    "description": "Heading of the fourth claim in 'How your notes are kept'."
  },
  "keptNothingReadableBody": "Photos, recordings and files are encrypted before they touch storage. Nothing is ever written out in the clear, not even briefly while you look at it.",
  "@keptNothingReadableBody": {
    "description": "The 'not even briefly' clause is the specific promise — it is what rule 2 of CLAUDE.md is about — and must not be softened to a general one."
  },
  "keptLocksItselfTitle": "It locks itself",
  "@keptLocksItselfTitle": {
    "description": "Heading of the fifth claim in 'How your notes are kept'."
  },
  "keptLocksItselfBody": "The moment Lamplight goes into the background the keys are destroyed. Screenshots are blocked and the app does not appear in the recent apps preview.",
  "@keptLocksItselfBody": {
    "description": "Describes lock-on-background, FLAG_SECURE and the recents thumbnail. Note the app ships a switch for screenshots — this text describes the default."
  },
  "keptBackUpTitle": "Back it up",
  "@keptBackUpTitle": {
    "description": "Heading of the sixth and last item in 'How your notes are kept'. An instruction, not a claim — it is the one thing the app cannot do for the reader."
  },
  "keptBackUpBody": "Everything is on this phone and nowhere else, which is the point and is also the risk. A backup is one encrypted file that only your passcode opens. Keep one somewhere.",
  "@keptBackUpBody": {
    "description": "Names the cost of the whole design in one sentence — 'which is the point and is also the risk'. Do not soften it; that honesty is the reason the rest is believable."
  }
}
