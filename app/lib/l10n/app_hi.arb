  "importIntro": "अगर आपने कहीं और डायरी लिखी है, तो Lamplight उसे ले आ सकता है — बशर्ते वो टेक्स्ट फ़ाइलें हों और नाम में तारीख़ हो।",
  "importHowDates": "यह सादी टेक्स्ट फ़ाइलें पढ़ता है और नाम में तारीख़ ढूँढता है — 2026-08-24, या 24 अगस्त 2026 — फ़ाइल के नाम में या ऊपर की फ़ोल्डरों में कहीं भी।",
  "importAmbiguousDates": "03-04-2026 जैसी तारीख़ें जानबूझकर छोड़ दी जाती हैं। कुछ देशों में यह तीन अप्रैल है और कुछ में चार मार्च, और ग़लत अंदाज़ा आपकी ज़िंदगी का एक साल ग़लत दिनों पर रख देगा, वो भी बिना बताए।",
  "importFormats": "Lamplight सादा टेक्स्ट पढ़ता है: .txt, .md, .org, .log और दूसरे, वो फ़ाइलें भी जिनका कोई एक्सटेंशन ही नहीं। अगर आपकी डायरी किसी और फ़ॉर्मैट में है, तो पहले उसे टेक्स्ट में निकाल लीजिए।",
  "importAtStartOfDay": "ये हर दिन की शुरुआत में बैठेंगे, क्योंकि फ़ाइल का नाम तारीख़ बताता है, वक़्त नहीं। Lamplight में जो पहले से है, वो न बदलेगा न हटेगा, और यह दो बार चलाने से कॉपियाँ नहीं बनेंगी।",
  "importFileDateNote": "इन्हें उस दिन पर रखता है जब फ़ाइल आख़िरी बार बदली गई थी। अगर फ़ोल्डर एक डिवाइस से दूसरे पर कॉपी हुई है, तो वो कॉपी होने का दिन हो सकता है, लिखने का नहीं।",
  "importSkippedNote": "ये छोड़ दी जाएँगी। ये जहाँ हैं वहीं रहेंगी — आपकी फ़ोल्डर से कुछ भी हटाया या मिटाया नहीं जाता।",
  "restoreChooseNote": "अपनी बैकअप फ़ाइल चुनिए। उसका नाम कुछ ऐसा होगा: Lamplight-2026-08-18.vault।",
  "restorePasscodeNote": "इस फ़ाइल का पासकोड लिखिए — वही जो बैकअप बनाते वक़्त लगा था।",
  "restoreWordsNote": "बारहों शब्द, क्रम से, बीच में जगह छोड़कर लिखिए।",
  "restoreDoNotClose": "जब तक यह पूरा न हो जाए, Lamplight बंद मत कीजिए।",
  "exportIntro": "यह Lamplight का सब कुछ आपकी चुनी हुई फ़ोल्डर में सादी फ़ाइलों की तरह लिख देता है — हर दिन की एक टेक्स्ट फ़ाइल, और हर फ़ोटो, वीडियो, आवाज़ का नोट और दस्तावेज़ अपने नाम से।",
  "exportNoLamplightNeeded": "उस फ़ोल्डर में कुछ भी खोलने के लिए Lamplight की ज़रूरत नहीं। अगर कभी यह ऐप चलना बंद कर दे, या आप इस्तेमाल छोड़ दें, तो भी आपके नोट हर उस चीज़ में खुलेंगे जो टेक्स्ट पढ़ती है।",
  "exportWhichOneBody": "पढ़ने लायक़ कॉपी पढ़ने के लिए है, किसी और ऐप में ले जाने के लिए, या Lamplight छोड़ने के बाद कुछ रख लेने के लिए। यह सुरक्षित नहीं होती।\n\nबैकअप फ़ाइल Lamplight को हूबहू वापस लाने के लिए है — नया फ़ोन, या टूटा हुआ फ़ोन। यह आपके पासकोड से बंद रहती है, इसलिए इसे कहीं भी रखा जा सकता है, क्लाउड में भी।\n\nज़्यादातर लोगों को बैकअप ही चाहिए। अगर पक्का करना है कि कभी अटकें नहीं, तो पढ़ने लायक़ कॉपी भी बना लीजिए।",
  "exportNotLockedBody": "इस पर कोई पासकोड नहीं होता। जो भी उस फ़ोल्डर को खोलेगा, सब पढ़ सकेगा। इसे वहीं रखिए जहाँ आपको यह मंज़ूर हो — और अगर सिर्फ़ कुछ सुरक्षित रखना है, तो बैकअप इस्तेमाल कीजिए।",
  "backupConfirmNote": "अपना पासकोड दोबारा दीजिए। यह फ़ाइल सब कुछ खोल सकती है, इसलिए इसे बनाना सोच-समझकर होना चाहिए।",
  "backupKeepSafeNote": "आपका बैकअप उसी पासकोड से बंद है जो अभी आपका है। इसे वहीं रखिए जिस पर भरोसा हो — क्लाउड भी ठीक है, क्योंकि उस पासकोड के बिना फ़ाइल पढ़ी ही नहीं जा सकती। हम उसे कभी नहीं देखते।",
  "backupRestoreWarning": "बैकअप खोलने से Lamplight में अभी जो कुछ है, सब बदल जाएगा। आपके अभी वाले नोट तब तक अलग रखे जाते हैं जब तक यह साबित न हो जाए कि वापस लाए गए नोट खुल रहे हैं।",
  "folderWhatItIs": "फ़ोल्डर एक धागा है जो आपके दिनों में से गुज़रता है — कोई एक इंसान, कोई एक जगह, कोई एक दौर।",
  "folderNothingMoves": "फ़ोल्डर में कुछ जाता नहीं है। बात अपने दिन पर ही रहती है और यहाँ भी दिख जाती है।",
  "folderDeleteNote": "फ़ोल्डर चला जाता है। उसमें जो कुछ था, वो जहाँ था वहीं रहता है, अपने ही दिन पर।",
  "folderNoneInHere": "यहाँ अभी कुछ नहीं है। किसी दिन पर कुछ देर दबाकर रखिए और “फ़ोल्डर में जोड़िए” चुनिए।",
