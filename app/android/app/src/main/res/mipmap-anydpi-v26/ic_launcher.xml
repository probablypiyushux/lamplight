<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive launcher icon, used from Android 8 onwards.

    Three layers, all generated by `flutter test tool/generate_icon_test.dart`
    from the same LampMarkPainter the app draws on its own lock screen. There is
    no hand-traced artwork anywhere in this project, so the launcher and the app
    cannot end up showing two different marks.

      background   the warm near-black plate, full bleed and square. The
                   launcher applies its own mask — circle, squircle, teardrop,
                   whatever this year's phone has decided on — so rounding any
                   corner here would show up as a notch inside that mask.

      foreground   the lamp, drawn at 0.667 so the whole of it stays inside the
                   72-of-108 safe zone and no mask can clip it.

      monochrome   Android 13+ tints this to the wallpaper palette for themed
                   icons. Only its alpha is used, so it is drawn flat in white
                   and any colour in it would be thrown away.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
