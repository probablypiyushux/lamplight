<?xml version="1.0" encoding="utf-8"?>
<!--
    GENERATED BY tool/generate_icon_test.dart's companion script. ISSUE 6b.

    One of twelve: six accents, dark and light. The lamp is the same drawing
    every time and only its **light** changes colour, which is what he asked for
    — "the icon's light takes the colour of the chosen accent".

    Launcher icons are static, so this cannot be a runtime tint. Each variant is
    an `activity-alias` in AndroidManifest.xml with exactly one enabled at a
    time; IconSwitcher.kt does the swapping and documents the ordering rule that
    stops the home-screen shortcut vanishing between the two calls.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background_light" />
    <foreground android:drawable="@mipmap/ic_launcher_fg_ember_light" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
